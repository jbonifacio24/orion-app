{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "ProductImages": {
    "StorageRoot": "storage/product-images",
    "PublicBasePath": "/media/product-images",
    "MaxFileSizeBytes": 5242880,
    "MaxImagesPerProduct": 10
  }
}
